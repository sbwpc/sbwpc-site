---
// SBWPC member admin. A standalone page: no site header, tracking or third-party scripts.
import '../../styles/fonts.css'
import '../../styles/admin.css'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>SBWPC Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="a-top">
      <img src="/brand/sbwpc-logo-acronym-color.svg" alt="SBWPC" width="150" height="36" />
      <div class="a-top-right" id="a-user" hidden>
        <span id="a-user-email"></span>
        <button type="button" class="a-btn ghost small" id="a-signout">Sign out</button>
      </div>
    </header>

    <main class="a-main" id="a-main">
      <p class="a-status" id="a-loading" role="status">Loading...</p>
      <noscript><p class="a-status">This page needs JavaScript turned on.</p></noscript>

      <!-- Sign in: the member system opens from the Sanity Studio -->
      <section class="a-card" id="v-signin" hidden aria-labelledby="h-signin">
        <h1 id="h-signin">Open this from the Studio</h1>
        <p class="a-sub">Member records for SBWPC board use only. Sign in to the website Studio, choose Members and donations, then press Open the member system. You will come back here already signed in.</p>
        <p class="a-error" id="e-signin" role="alert" hidden></p>
        <a class="a-btn" id="a-studio" href="https://sbwpc.sanity.studio/">Go to the Studio</a>
      </section>

      <!-- No access -->
      <section class="a-card" id="v-denied" hidden aria-labelledby="h-denied">
        <h1 id="h-denied">This account does not have access</h1>
        <p class="a-sub">You are signed in, but this email is not on the SBWPC admin list. Ask an SBWPC admin to add you.</p>
        <button type="button" class="a-btn" id="a-denied-out">Sign out</button>
      </section>

      <!-- Signed in: the admin screens are drawn into #app by the script -->
      <section id="v-dash" hidden>
        <nav class="a-nav" aria-label="Admin sections">
          <a href="#/" data-nav="">Overview</a>
          <a href="#/members" data-nav="members">Members</a>
          <a href="#/payments" data-nav="payments">Donors and payments</a>
          <a href="#/checks" data-nav="checks">Checks to confirm <span class="a-badge" id="nav-checks-n" hidden></span></a>
          <a href="#/new" data-nav="new" id="nav-new" class="a-nav-add">Add a person</a>
        </nav>
        <p class="a-flash" id="a-flash" role="status" aria-live="polite" hidden></p>
        <div id="app"></div>
      </section>
    </main>

    <script>
      import '../../scripts/admin/app.js'
    </script>
  </body>
</html>
