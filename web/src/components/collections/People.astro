---
import Img from '../Img.astro'
import RichText from '../RichText.astro'
import {slugify} from '../../lib/data.js'
const {items} = Astro.props
const groups = [...new Set(items.map((p) => p.group).filter(Boolean))]
---
<div class="people" data-filter-root>
  {groups.length > 1 && (
    <div class="chips" role="group" aria-label="Filter leaders">
      <button class="chip" aria-pressed="true" data-filter="all">All leaders</button>
      {groups.map((g) => <button class="chip" aria-pressed="false" data-filter={slugify(g)}>{g}s</button>)}
    </div>
  )}
  <ul class="people-grid">
    {items.map((p, i) => (
      <li class="person" data-group={slugify(p.group)} data-reveal style={`--d:${(i % 4) * 50}ms`}>
        <button class="person-btn" data-dialog={`p-${p._id}`}>
          <div class="person-photo frame ratio-1x1">{p.image ? <Img image={p.image} width={600} sizes="(min-width: 64rem) 22vw, 45vw" aspect={1} /> : <span class="initials">{p.name.split(' ').map((w) => w[0]).join('')}</span>}</div>
          <span class="person-meta">
            <span class="kicker">{p.group}</span>
            <span class="person-name">{p.name}</span>
            <span class="person-role">{p.role}</span>
            {p.shortBio && <span class="person-bio">{p.shortBio}</span>}
            <span class="textlink"><span class="arrow">View profile</span></span>
          </span>
        </button>
        <dialog class="modal" id={`p-${p._id}`} aria-labelledby={`pn-${p._id}`}>
          <div class="modal-inner">
            <button class="modal-close" data-close><span class="sr-only">Close</span><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
            <div class="modal-head">
              {p.image && <div class="frame ratio-1x1 modal-photo"><Img image={p.image} width={400} sizes="10rem" aspect={1} /></div>}
              <div>
                <p class="kicker">{p.group}</p>
                <h3 class="h3" id={`pn-${p._id}`}>{p.name}</h3>
                <p class="person-role">{p.role}</p>
              </div>
            </div>
            {p.bio?.length ? <RichText value={p.bio} /> : p.shortBio && <p>{p.shortBio}</p>}
            {p.email && <p class="buttons"><a class="btn" href={`mailto:${p.email}`}>Email {p.name.split(' ')[0]}</a></p>}
          </div>
        </dialog>
      </li>
    ))}
  </ul>
</div>
