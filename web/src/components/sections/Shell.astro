---
// Common wrapper: background tone, eyebrow, heading, intro, buttons.
import Buttons from '../Buttons.astro'
const {s, wide = false, headSplit, buttonsBelow = true, level = 2} = Astro.props
const tone = s.tone || 'white'
const hasHead = s.heading || s.intro
const split = headSplit ?? (s.intro && s.intro.length < 220 && s.heading)
const H = level === 2 ? 'h2' : 'h3'
---
<section class:list={['section', `tone-${tone}`, `s-${s._type}`]} id={s.anchor || undefined}>
  <div class="wrap">
    {hasHead && (
      <div class:list={['section-head', {split}]} data-reveal>
        <div>
          
          {s.heading && <H class="h2">{s.heading}</H>}
        </div>
        {s.intro && <p class="lede">{s.intro}</p>}
      </div>
    )}
    <slot />
    {buttonsBelow && <Buttons buttons={s.buttons} />}
  </div>
</section>
