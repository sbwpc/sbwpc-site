---
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import RichText from '../../components/RichText.astro'
import Img from '../../components/Img.astro'
import Posts from '../../components/collections/Posts.astro'
import {loadAll, fmtDate, img} from '../../lib/data.js'
import {newsLd, pageUrl, BYLINE} from '../../lib/seo.js'
export async function getStaticPaths() {
  const {posts} = await loadAll()
  const list = posts.filter((p) => p.slug?.current && !p.externalUrl)
  // Each post links to the three posts that follow it (wrapping around), so every post gets inbound links.
  return list.map((post, i) => ({params: {slug: post.slug.current}, props: {post, more: list.length > 1 ? Array.from({length: Math.min(3, list.length - 1)}, (_, k) => list[(i + 1 + k) % list.length]) : []}}))
}
const {post, more} = Astro.props
const shareImg = post.image ? img(post.image, {width: 1200}) : null
const ld = newsLd(post, pageUrl(`news/${post.slug.current}`), shareImg?.src)
---
<Layout title={post.title} description={post.excerpt} image={post.image} path={`news/${post.slug.current}`} jsonld={ld} published={post.date} modified={post._updatedAt}>
  <Breadcrumbs path={`news/${post.slug.current}`} title={post.title} />
  <article class="article">
    <header class="section tone-cream article-head">
      <div class="wrap narrow" data-reveal>
        <h1 class="h1">{post.title}</h1>
        <p class="meta article-date">By {BYLINE}, published <time datetime={post.date}>{fmtDate(post.date)}</time></p>
        {post.excerpt && <p class="lede">{post.excerpt}</p>}
      </div>
    </header>
    {post.image && (
      <figure class="wrap article-img" data-reveal>
        <div class="frame"><Img image={post.image} width={1600} sizes="(min-width: 76rem) 76rem, 100vw" eager /></div>
        {post.image.caption && <figcaption class="caption">{post.image.caption}</figcaption>}
      </figure>
    )}
    <div class="section tone-white">
      <div class="wrap narrow"><RichText value={post.body} /></div>
    </div>
  </article>
  {more.length > 0 && (
    <section class="section tone-cream">
      <div class="wrap">
        <div class="section-head split"><div><h2 class="h2">More from SBWPC</h2></div><p class="lede"><a class="textlink" href="/news"><span class="arrow">All news</span></a></p></div>
        <Posts items={more} />
      </div>
    </section>
  )}
</Layout>
