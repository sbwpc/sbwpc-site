---
import PageView from '../views/PageView.astro'
import {loadAll, explainersAfter} from '../lib/data.js'
export async function getStaticPaths() {
  const {pages} = await loadAll()
  // Explainers link to the three that follow them (wrapping around) so none is a dead end.
  return pages.filter((p) => p.path && p.path !== 'home').map((page) => ({params: {path: page.path}, props: {page, related: explainersAfter(pages, page)}}))
}
const {page, related} = Astro.props
---
<PageView page={page} related={related} />
