---
import Buttons from '../Buttons.astro'
const {s} = Astro.props
const tone = s.tone || 'navy'
---
<section class:list={['section', 'cta', `tone-${tone}`]} id={s.anchor || undefined}>
  <div class="wrap cta-inner" data-reveal>
    <div>
      {s.eyebrow && <p class="eyebrow gold">{s.eyebrow}</p>}
      {s.heading && <h2 class="h2">{s.heading}</h2>}
      {s.intro && <p class="lede">{s.intro}</p>}
    </div>
    <Buttons buttons={s.buttons} class="buttons cta-buttons" />
  </div>
</section>
