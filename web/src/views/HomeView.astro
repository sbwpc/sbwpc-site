---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Sections from '../components/Sections.astro'
const {page, noindex = false} = Astro.props
---
<Layout title={page.seo?.title || page.title} description={page.seo?.description} image={page.seo?.image || page.hero?.image} path="home" noindex={noindex}>
  {page.hero && <Hero hero={page.hero} />}
  <Sections sections={page.sections} />
</Layout>
