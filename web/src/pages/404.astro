---
import Layout from '../layouts/Layout.astro'
---
<Layout title="Page not found" path="404" noBanner>
  <section class="section tone-cream notfound">
    <div class="wrap narrow">
      <p class="eyebrow">Page not found</p>
      <h1 class="h1">This page has moved or no longer exists.</h1>
      <p class="lede">The SBWPC site was recently rebuilt, so some addresses changed. These are the most visited places:</p>
      <div class="buttons">
        <a class="btn" href="/elections/endorsements">2026 Endorsements</a>
        <a class="btn secondary" href="/elections">Election Center</a>
        <a class="btn secondary" href="/events">Events</a>
        <a class="btn secondary" href="/">Home</a>
      </div>
    </div>
  </section>
</Layout>
