---
import Shell from './Shell.astro'
import RichText from '../RichText.astro'
import {faqLd, ldScript} from '../../lib/seo.js'
const {s} = Astro.props
const faq = faqLd(s.items)
---
{faq && <script type="application/ld+json" set:html={ldScript(faq)} />}
<Shell s={s}>
  <div class="accordion" data-reveal>
    {(s.items || []).map((it) => (
      <details class="acc">
        <summary>
          <span class="acc-head">
            <span class="acc-title">{it.title}</span>
            {it.kicker && <span class="meta">{it.kicker}</span>}
            {it.summary && <span class="acc-sum">{it.summary}</span>}
          </span>
          <span class="acc-icon" aria-hidden="true"></span>
        </summary>
        <div class="acc-body"><RichText value={it.body} /></div>
      </details>
    ))}
  </div>
</Shell>
