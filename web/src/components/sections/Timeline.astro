---
import Shell from './Shell.astro'
const {s} = Astro.props
const items = s.items || []
const n = items.length
// One row for up to six steps; longer timelines wrap into even rows.
const cols = n <= 6 ? Math.max(n, 1) : ([5, 4, 3].find((c) => n % c === 0) ?? 4)
const isStep = (l) => typeof l === 'string' && /^\s*\d{1,2}\s*$/.test(l)
---
<Shell s={s}>
  <ol class="timeline" style={`--cols:${cols}`}>
    {items.map((it, i) => (
      <li data-reveal style={`--d:${(i % cols) * 60}ms`}>
        {isStep(it.label)
          ? <span class="t-dot t-num" aria-hidden="true">{it.label.trim()}</span>
          : <span class="t-dot" aria-hidden="true"></span>}
        {it.title && <h3 class="h4">{it.title}</h3>}
        {it.label && !isStep(it.label) && <p class="meta t-date">{it.label}</p>}
        {it.body && <p class="t-body">{it.body}</p>}
      </li>
    ))}
  </ol>
</Shell>
